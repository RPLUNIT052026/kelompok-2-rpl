# ==============================================================================
# HYPEREVAC SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Salin file ini menjadi '.env' di folder setup-code/ dan sesuaikan nilainya:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL + PostGIS)
# ------------------------------------------------------------------------------
POSTGRES_DB=hyperevac_db
POSTGRES_USER=hyperevac_user
POSTGRES_PASSWORD=hyperevac_password_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL Koneksi Database Lengkap (digunakan oleh psycopg2/SQLAlchemy)
DATABASE_URL=postgresql://hyperevac_user:hyperevac_password_secret@localhost:5432/hyperevac_db

# ------------------------------------------------------------------------------
# 2. BMKG API ENDPOINTS & WILAYAH
# ------------------------------------------------------------------------------
# Endpoint Data Gempa Terkini (JSON)
BMKG_GEMPA_URL=https://data.bmkg.go.id/DataMKG/TEWS/autogempa.json

# Endpoint Prakiraan Cuaca (API Publik BMKG)
BMKG_CUACA_URL=https://api.bmkg.go.id/publik/prakiraan-cuaca

# Kode Wilayah Administrasi Tingkat IV / Kelurahan (contoh: Langsa / Aceh)
# Masukkan kode adm4 area rawan bencana yang ditargetkan
BMKG_ADM4=11.74.02.2001

# ------------------------------------------------------------------------------
# 3. AGGREGATOR & RESILIENCE SETTINGS
# ------------------------------------------------------------------------------
# Timeout HTTP Request (dalam detik)
HTTP_TIMEOUT=10.0

# Jumlah Percobaan Ulang (Retry) jika API BMKG Timeout/Error
HTTP_RETRIES=3

# Folder Penyimpanan Cache Lokal (fallback saat API publik down)
CACHE_DIR=.cache

# Interval Polling Data (dalam detik, default 60 detik)
FETCH_INTERVAL_SECONDS=60
